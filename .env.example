# ===================================================
# MediLedger Environment Configuration Example
# Copy this file to .env for local configuration
# ===================================================

# Blockchain Network Configuration
BLOCKCHAIN_RPC_URL=http://127.0.0.1:8545
CHAIN_ID=31337

# Deployed Smart Contract Addresses (Populated automatically after deployment)
RECORD_REGISTRY_ADDRESS=
CONSENT_MANAGER_ADDRESS=
AUDIT_LOGGER_ADDRESS=

# Backend API Configuration
PORT=5000
NODE_ENV=development
API_BASE_URL=http://localhost:5000

# Off-chain Document Storage Path
DOCUMENT_STORAGE_DIR=./storage/documents

# Frontend Vite Port
VITE_API_URL=http://localhost:5000/api
VITE_BLOCKCHAIN_RPC=http://127.0.0.1:8545
